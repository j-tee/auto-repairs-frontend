# .env.local.example
# Copy this file to .env.local and customize for your local development setup
# .env.local is ignored by git and takes precedence over other .env files

# Local API Configuration
# Uncomment and modify if your backend runs on a different host/port
# VITE_API_BASE_URL=http://localhost:8000/api
# VITE_API_BASE_URL=http://192.168.1.100:8000/api

# Local Development Features
# VITE_ENABLE_MOCK_API=true
# VITE_LOG_LEVEL=verbose
# VITE_API_TIMEOUT=20000

# Override app name for local testing
# VITE_APP_NAME=Auto Repairs [LOCAL]
