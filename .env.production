# Production Environment Variables
# Automatically loaded when NODE_ENV=production

# API Configuration - Production Backend
VITE_API_BASE_URL=https://api.autorepairs.example.com/api

# Production Features
VITE_DEV_MODE=false
VITE_LOG_LEVEL=error
VITE_ENABLE_DEBUG_TOOLS=false
VITE_ENABLE_MOCK_API=false

# Production timeouts (stricter)
VITE_API_TIMEOUT=8000
VITE_TOKEN_REFRESH_THRESHOLD=240000

# Application Info
VITE_APP_NAME=Auto Repairs Management System
VITE_APP_VERSION=1.0.0
